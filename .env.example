# =================================
# Vira - AI Real Estate Assistant
# =================================

# Supabase (create a project, then Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose

# Google Gemini AI (from https://aistudio.google.dev)
GEMINI_API_KEY=

# Google OAuth (Google Cloud Console - APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=                  # Generate with: openssl rand -base64 32

# Admin dashboard password - always set this
ADMIN_PASSWORD=
